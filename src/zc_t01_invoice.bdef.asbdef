projection implementation in class ZBP_C_T01_INVOICE unique;
strict ( 2 );
extensible;
use draft;
use side effects;

define behavior for ZC_T01_INVOICE alias ZcT01Invoice
extensible
use etag
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Invoice_Itm { create; with draft; }
}

define behavior for ZC_T01_INVOICE_ITM alias ZcT01InvoiceItm
{
  use update;
  use delete;

  use association _Invoice { with draft; }
}