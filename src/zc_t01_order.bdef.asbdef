projection implementation in class ZBP_C_T01_ORDER unique;
strict ( 2 );
extensible;
use draft;
use side effects;

define behavior for ZC_T01_ORDER alias ZcT01Order
extensible
use etag
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Orders_Itm { create; with draft; }
}

define behavior for ZC_T01_ORDER_ITM alias ZcT01OrderITM
{
  use update;
  use delete;

  use association _Orders { with draft; }
}